# ---- Providers ---------------------------------------------------------------
# OCR: textract (production, wraps the existing DOB pipeline) | tesseract (offline dev)
OCR_PROVIDER=tesseract
# Face: rekognition | local (run scripts/download_models.py) | off
FACE_PROVIDER=local
# LLM for structuring + forensic narration: anthropic | bedrock | off  (never makes decisions)
LLM_PROVIDER=off
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

AWS_REGION=ap-south-1
REKOGNITION_COLLECTION=trustgate-faces
# If Hackingly's existing DOB pipeline runs as a service, point to it:
LEGACY_DOB_URL=

# ---- Security & privacy ---------------------------------------------------------
API_KEY=                       # required header X-API-Key on /v1/verify when set
ORGANIZER_KEY=                 # required header X-Organizer-Key on the review queue,
                               # case detail, artifacts, metrics and audit log.
                               # Leave empty for a laptop demo; set it before any real data.
ID_HMAC_SECRET=replace-with-32+-random-bytes
WEBHOOK_SECRET=
KEEP_RAW_IMAGES=false          # only masked copies are stored by default
UIDAI_CERT_PATH=               # UIDAI public cert; for local demos run scripts/make_dev_cert.py and use dev_certs/uidai_dev_cert.pem
CORS_ORIGINS=*

# ---- Thresholds (re-tune with scripts/evaluate.py on real samples) ---------------------
APPROVE_THRESHOLD=0.78
REJECT_DOB_CONFIDENCE=0.85
BLUR_THRESHOLD=60
GLARE_THRESHOLD=0.10
MIN_SIDE_PX=400
RECAPTURE_PEAK=5.5
PHASH_DISTANCE=8
NAME_MATCH_OK=88
NAME_MATCH_REVIEW=72
FACE_MATCH_OK=90
FACE_MATCH_REVIEW=70
