{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "Textract", "Effect": "Allow", "Action": ["textract:AnalyzeDocument", "textract:DetectDocumentText"], "Resource": "*" },
    { "Sid": "Rekognition", "Effect": "Allow",
